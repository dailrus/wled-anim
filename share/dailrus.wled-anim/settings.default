# Настройки WLED Animation; их же меняет веб-интерфейс http://<станция>:8098
# brightness — яркость 0..1, speed — скорость смены цвета
# mode — rainbow | mono | vu | pulse | spectrum | wled_fx
# mono_color — цвет для mode=mono: rrggbb (например ff3c00) или auto — меняется по музыке
# amp_bright — rainbow/mono: насколько яркость столба зависит от громкости баса 0..1 (0 — всегда полная)
# spec_style — окраска режима spectrum: rainbow (цвета крутятся) | colors (свои цвета зон) | gradient
# spec_c1 / spec_c2 / spec_c3 — цвета rrggbb: бас, середина, верх
# spec_layout — где частоты на ленте: center (бас в центре) | edges (бас по краям) |
#   start (бас в начале → верх в конце) | end (верх в начале → бас в конце)
# spec_blend — плавность градиента 0..1 (1 — плавный, меньше — резкие переходы)
# spec_w_bass / spec_w_mid / spec_w_high — ширина зон частот, доли ленты относительно друг друга
# output — wled (светомузыка на ленте) | off (выключена)
# delay_ms — задержка света относительно звука, мс (0..300, шаг 10; 0 по умолчанию)
brightness=0.31
speed=1.0
mode=rainbow
mono_color=ff0000
amp_bright=0.6
spec_style=rainbow
spec_c1=ff0000
spec_c2=00ff00
spec_c3=0000ff
spec_layout=center
spec_blend=1
spec_w_bass=0.4
spec_w_mid=0.2
spec_w_high=0.4
output=wled
wled_ip=
wled_leds=188
delay_ms=0
# --- плавность/задержка ---
# fps — кадров/с на ленту (10..100; данные идут 100 раз/с, кадр шлётся сразу по их приходу)
# gamma — гамма-коррекция ленты (1 = выкл, 2.2 по умолчанию; WLED в live её не применяет)
# smooth — сила сглаживания (0 = минимум, 1 = норма, до 3 — очень плавно)
fps=50
gamma=2.2
smooth=2.4
# --- mode=wled_fx: станция не рисует, а модулирует штатный эффект WLED ---
# fx_id — номер эффекта WLED на время музыки (-1 = оставить текущий), fx_pal — палитра (-1 = текущая)
# fx_color — 1: основной цвет сегмента крутится по радуге, 0: не трогать
# fx_ix — 1: интенсивность эффекта по середине/верхам, 0: не трогать
# fx_floor — минимальная яркость 0..1 (в тишине), fx_fps — пакетов/с на WLED (5..50)
fx_id=9
fx_pal=0
fx_color=1
fx_ix=1
fx_floor=0.2
fx_fps=30
# --- паразитные мигания ---
# gate — порог тишины относительно обычной громкости трека (0..0.5; 0.093 по умолчанию, больше — строже)
# sens_bass / sens_mid / sens_high — чувствительность полос 0..1: меньше — мелкие частые всплески
#   в полосе не зажигают ленту (по умолчанию бас 0.5, середина 0.5, верх 0.7)
# flash_sens — чувствительность белой вспышки на ударе 0..1 (0 — выключена, по умолчанию 0)
# alice_mute — 1: гасить светомузыку, пока Алиса слушает/думает/говорит; 0: не гасить
gate=0.093
sens_bass=0.5
sens_mid=0.5
sens_high=0.7
flash_sens=0
alice_mute=1
